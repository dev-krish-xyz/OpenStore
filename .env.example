# Optional for guest submissions; required for voting, feedback, and admin access.
# Use http://localhost:3000/api/auth/github/callback locally.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub API token for higher metadata-fetch rate limits.
GITHUB_TOKEN=

# Comma-separated GitHub logins allowed to moderate submissions.
ADMIN_GITHUB_LOGINS=

# Store this file on a persistent volume in production.
OPENSTORE_DB_PATH=.data/openstore.sqlite

# Optional login name used by the local-only development sign-in.
OPENSTORE_DEV_LOGIN=local-admin
